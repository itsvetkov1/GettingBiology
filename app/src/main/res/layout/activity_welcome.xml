<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:fitsSystemWindows="true"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Layer 1: DNA Background -->
    <ImageView
        android:id="@+id/backgroundImageView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/welcome_animation2" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/languageToggleButton"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:text="@string/language_toggle_to_en"
        android:contentDescription="@string/language_toggle_content_description"
        android:textColor="@color/md_theme_light_primary"
        app:backgroundTint="@color/white_90_opacity"
        app:cornerRadius="22dp"
        app:strokeColor="@color/md_theme_light_primary"
        app:strokeWidth="1dp" />

    <!-- Layer 3: Logo -->
    <ImageView
        android:id="@+id/logoImageView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="0dp"
        android:layout_marginTop="120dp"
        android:adjustViewBounds="true"
        android:elevation="8dp"
        android:alpha="0.8"
        android:src="@drawable/logo" />

    <!-- Layer 4: Bottom Sheet Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomSheetCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:cardBackgroundColor="@color/white_90_opacity"
        app:cardElevation="8dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.TopRounded">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="32dp"
            android:paddingBottom="24dp"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/headerTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/welcome_title"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/md_theme_light_primary"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/subtitleTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/welcome_subtitle"
                android:textSize="16sp"
                android:textColor="@color/gray_600"
                android:layout_marginBottom="24dp" />

            <LinearLayout
                android:id="@+id/categoryButtonContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/startQuizButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="@string/start_button"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    app:backgroundTint="@color/md_theme_light_primary"
                    app:cornerRadius="12dp"
                    app:elevation="2dp"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/statsButton"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/stats_title"
                    android:textSize="14sp"
                    android:textColor="@color/md_theme_light_primary"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/md_theme_light_primary"
                    app:strokeWidth="1dp"
                    app:icon="@android:drawable/ic_menu_recent_history"
                    app:iconGravity="textStart"
                    app:iconTint="@color/md_theme_light_primary" />

            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
