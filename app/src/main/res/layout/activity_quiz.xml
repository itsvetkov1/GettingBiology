<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- Main Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nested_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Question Info -->
            <TextView
                android:id="@+id/tv_question_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/question_counter_placeholder"
                android:textSize="14sp"
                android:textColor="@color/gray_600"
                android:layout_marginBottom="8dp" />

            <!-- Question Text -->
            <TextView
                android:id="@+id/tv_question_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/question_placeholder"
                android:textSize="18sp"
                android:textColor="@color/black"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="16dp" />

            <!-- Answer Options -->
            <!-- Option 1 -->
            <Button
                android:id="@+id/btn_option_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/option_1_placeholder"
                android:background="@drawable/option_button_background"
                android:textColor="@color/gray_800"
                android:layout_marginBottom="8dp" />

            <!-- Option 2 -->
            <Button
                android:id="@+id/btn_option_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/option_2_placeholder"
                android:background="@drawable/option_button_background_correct"
                android:textColor="@color/green_800"
                android:layout_marginBottom="8dp" />

            <!-- Option 3 -->
            <Button
                android:id="@+id/btn_option_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/option_3_placeholder"
                android:background="@drawable/option_button_background_incorrect"
                android:textColor="@color/red_800"
                android:layout_marginBottom="8dp" />

            <!-- Option 4 -->
            <Button
                android:id="@+id/btn_option_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/option_4_placeholder"
                android:background="@drawable/option_button_background"
                android:textColor="@color/gray_800"
                android:layout_marginBottom="8dp" />

            <!-- Next Button -->
            <Button
                android:id="@+id/btn_next"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/next_button"
                android:backgroundTint="@color/blue_500"
                android:textColor="@android:color/white"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="24dp"
                android:elevation="2dp"
                android:stateListAnimator="@null" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Navigation -->
    <LinearLayout
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@android:color/white"
        android:padding="8dp"
        android:layout_gravity="bottom"
        android:weightSum="2"
        android:elevation="4dp">

        <!-- Score Section -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tv_score_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/score_label"
                android:textSize="12sp"
                android:textColor="@color/gray_600" />

            <TextView
                android:id="@+id/tv_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 / 1"
                android:textSize="18sp"
                android:textColor="@color/blue_500"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- Time Section -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tv_time_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/time_label"
                android:textSize="12sp"
                android:textColor="@color/gray_600" />

            <TextView
                android:id="@+id/tv_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:45"
                android:textSize="18sp"
                android:textColor="@color/black"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
