WHERE id = '112'
questionText LIKE '%ВЪЗПРОИЗВОДСТВЕН%' AND
options LIKE '%ВЪЗПРОИЗВОДСТВЕН%'


SELECT * FROM questions
WHERE questionText = 'Какво е геном?'

UPDATE questions
SET   options = 'място на среща между два нерва;връзка между нервна клетка и мускул;място на предаване на нервен импулс между две нервни клетки;вид хормон'
 --questionText = 'Как се нарича способността на организма да се приспособява към променящите се условия на околната среда??'
WHERE questionText = 'местоположение на среща между два нерва;връзка между нервна клетка и мускул;място на предаване на нервен импулс между две нервни клетки;вид хормон'
AND id = '112';

DELETE FROM questions
WHERE id NOT IN (
  SELECT MIN(q.id)
  FROM questions q
  GROUP BY q.questionText, q.options, q.correctAnswer
);

DELETE from questions
WHERE id = '90'

-- Update the 'questionText' column
UPDATE questions
SET questionText = REPLACE(questionText, 'генната инженерия', 'генното инженерство')
WHERE questionText LIKE '%генната инженерия%';

-- Update the 'options' column
UPDATE questions
SET options = REPLACE(options, 'генната инженерия', 'генното инженерство')
WHERE options LIKE '%генната инженерия%';

-- Update the 'correctAnswer' column
UPDATE questions
SET correctAnswer = REPLACE(correctAnswer, 'генната инженерия', 'генното инженерство')
WHERE correctAnswer LIKE '%генната инженерия%';


PRAGMA foreign_keys = OFF;
DELETE FROM questions WHERE id = 81;
</sql><sql name="SQL 3">SELECT * FROM questions
WHERE id = '90'

SELECT * FROM questions
WHERE questionText = 'Какво е геном?'

UPDATE questions
SET   options = 'Комплекс от микроорганизми в човешкото тяло;Вид бактериална инфекция;Метод за производство на антибиотици;Система за пречистване на водата'
-- questionText = 'Какво представлява генното инженерство?'
WHERE questionText = 'Какво представляват микробиомите?'
AND id = '77';

DELETE FROM questions
WHERE id NOT IN (
  SELECT MIN(q.id)
  FROM questions q
  GROUP BY q.questionText, q.options, q.correctAnswer
);

DELETE from questions
WHERE id = '90'

-- Update the 'questionText' column
UPDATE questions
SET questionText = REPLACE(questionText, 'генната инженерия', 'генното инженерство')
WHERE questionText LIKE '%генната инженерия%';

-- Update the 'options' column
UPDATE questions
SET options = REPLACE(options, 'генната инженерия', 'генното инженерство')
WHERE options LIKE '%генната инженерия%';

-- Update the 'correctAnswer' column
UPDATE questions
SET correctAnswer = REPLACE(correctAnswer, 'генната инженерия', 'генното инженерство')
WHERE correctAnswer LIKE '%генната инженерия%';


PRAGMA foreign_keys = OFF;
DELETE FROM questions WHERE id = 81;
